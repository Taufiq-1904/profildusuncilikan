# Salin menjadi .env.local (lokal) dan isi juga di Vercel > Settings > Environment Variables.
# Nilainya ada di Supabase > Project Settings > API (atau tombol "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Domain final situs (tanpa garis miring di akhir).
NEXT_PUBLIC_SITE_URL=https://dusuncilikan.web.id

# HANYA di server (Vercel > Environment Variables, JANGAN pakai awalan NEXT_PUBLIC_).
# Dipakai satu fitur: akun Dusun mengatur ulang password akun RW/RT.
# Ambil dari Supabase > Project Settings > API > service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=
